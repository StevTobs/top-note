# Copy to .env (or .env.local) and fill in from Supabase → Project Settings → API.
# Only the publishable (anon) key belongs here. Never put a secret / service_role key in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are also accepted.
